generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Status {
  PENDING
  APPROVED
  DENIED
}

model User {
  id            String   @id @default(uuid())
  clerkUserId   String?  @unique
  uniqueAdminId String?  @unique
  securityPin   String
  fullName      String
  email         String   @unique
  designation   String
  lga           String
  state         String
  phoneNumber   String?
  role          Role     @default(USER)
  status        Status   @default(PENDING)
  emailSent     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Linked farmer records registered by this user/agent
  farmers Farmer[]

  // Comments made by this user on admin report summaries
  adminComments AdminReportComment[]
}

// ==========================================
// Farmer Registration Model
// ==========================================
model Farmer {
  id                     String  @id @default(uuid())
  fullName               String
  age                    Int
  gender                 String
  highestEducation       String
  maritalStatus          String
  householdSize          Int?
  state                  String
  lga                    String
  cluster                String
  userGroup              String
  nameOfChosenEnterprise String
  typeOfEnterprise       String
  estimatedAnnualIncome  Float
  phoneNumber            String
  photoUrl               String?

  // Relation back to the User/Agent who created this record (REQUIRED)
  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserReport {
  id         String   @id @default(uuid())
  authorName String
  role       String
  state      String
  fileName   String
  fileUrl    String
  createdAt  DateTime @default(now())
}

model AdminReportSummary {
  id              String   @id @default(uuid())
  execSummary     String   @db.Text
  keyMetrics      String   @db.Text
  recommendations String   @db.Text
  fileName        String
  fileUrl         String
  createdAt       DateTime @default(now())

  // Opposite relation field for comments
  comments AdminReportComment[]
}

model AdminReportComment {
  id        String             @id @default(uuid())
  summaryId String
  summary   AdminReportSummary @relation(fields: [summaryId], references: [id], onDelete: Cascade)

  // Make userId optional so comments can be posted safely even if user reference is missing/omitted
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  authorName String
  authorRole String
  content    String   @db.Text
  createdAt  DateTime @default(now())
}