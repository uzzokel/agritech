generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Status {
  PENDING
  APPROVED
  DENIED
}

enum BlogCategory {
  FIELD_INSIGHTS
  ADVISORIES
  POLICY_BRIEFS
  TECH_UPDATES
  MARKET_INSIGHTS

  // Legacy variants retained for database compatibility
  POLICY
  TECH
  MARKET
}

model User {
  id            String   @id @default(uuid())
  clerkUserId   String?  @unique
  uniqueAdminId String?  @unique
  securityPin   String
  fullName      String
  email         String   @unique
  designation   String
  lga           String
  state         String
  phoneNumber   String?
  role          Role     @default(USER)
  status        Status   @default(PENDING)
  emailSent     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Linked farmer records registered by this user/agent
  farmers Farmer[]

  // Comments made by this user on admin report summaries
  adminComments AdminReportComment[]
}

// ==========================================
// Farmer Registration Model
// ==========================================
model Farmer {
  id                     String   @id @default(uuid())
  fullName               String
  age                    Int
  gender                 String
  highestEducation       String
  maritalStatus          String
  householdSize          Int?
  state                  String
  lga                    String
  cluster                String
  userGroup              String
  nameOfChosenEnterprise String
  typeOfEnterprise       String
  estimatedAnnualIncome  Float
  phoneNumber            String
  photoUrl               String?

  // Relation back to the User/Agent who created this record (REQUIRED)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserReport {
  id         String   @id @default(uuid())
  authorName String
  role       String
  state      String
  fileName   String
  fileUrl    String
  createdAt  DateTime @default(now())
}

model AdminReportSummary {
  id              String   @id @default(uuid())
  execSummary     String   @db.Text
  keyMetrics      String   @db.Text
  recommendations String   @db.Text
  fileName        String
  fileUrl         String
  createdAt       DateTime @default(now())

  // Opposite relation field for comments
  comments AdminReportComment[]
}

model AdminReportComment {
  id        String             @id @default(uuid())
  summaryId String
  summary   AdminReportSummary @relation(fields: [summaryId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  authorName String
  authorRole String
  content    String   @db.Text
  createdAt  DateTime @default(now())
}

// ==========================================
// WorkPlan Category Model
// ==========================================
model Category {
  id        String   @id @default(uuid())
  name      String   @unique // e.g. "CIVIL_WORKS", "PERSONNEL", "CONSULTANCY", etc.
  code      String?  @unique // Optional short code if needed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workPlans WorkPlan[]
}

// ==========================================
// 1. First Table: WorkPlan & Budget Uploads
// ==========================================
model WorkPlan {
  id                  String   @id @default(uuid())
  componentName       String   // e.g. "Component 1: Capacity building"
  
  // Relational link to the Category table
  categoryId          String?
  category            Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  
  budgetCategory      String?  // Kept as optional string fallback for uploaded raw values

  description         String   @db.Text // Max 300 words description
  detailedCalculation String   @db.Text // Calculation details text
  unitCost            Float?   @default(0.0) // Optional cost per unit
  quantity            Float?   @default(0.0) // Optional number of units
  totalCostEstimate   Float    // Cost in chosen currency (unitCost * quantity)
  currency            String   @default("USD")
  timeFrame           String   // e.g. "Q1 2026 (Months 1-3)"
  expectedOutput      String   @db.Text // Narrative of expected results
  state               String?  @default("National (HQ)") // Implementation state or Hub
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Linked performance tracking record (1-to-1 relation)
  performance         BudgetPerformance?
}

// ==========================================
// 2. Second Table: Budget Performance (Linked)
// ==========================================
model BudgetPerformance {
  id              String   @id @default(uuid())
  workPlanId      String   @unique
  workPlan        WorkPlan @relation(fields: [workPlanId], references: [id], onDelete: Cascade)

  amountDisbursed Float    @default(0.0)
  actualOutput    String?  @db.Text // Actual progress notes
  statusFlag      String   @default("GREEN") // GREEN, AMBER, RED

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ==========================================
// 3. Performance Target (Table 1: Planning)
// ==========================================
model PerformanceTarget {
  id                  String   @id @default(uuid())
  componentName       String   // e.g., "Component 1: Capacity building"
  expectedOutcomes    String   @db.Text // KPI narration (Max 300 words)
  targetPercentage    Float    // Target in % (e.g., 100)
  baselineValue       Float    @default(0.0) // Baseline value (0 if none)
  meansOfVerification String   @db.Text // Means of verification description
  timeFrame           String   // e.g., "Q3 2026 (Month 7 - Month 9)"
  responsiblePerson   String   // Person or Unit responsible
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relation to Table 2 (Actuals & Progress Tracking)
  actuals             PerformanceActual[]
}

// ==========================================
// 4. Performance Actual (Table 2: Monitoring & Variance)
// ==========================================
model PerformanceActual {
  id          String            @id @default(uuid())
  targetId    String
  target      PerformanceTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)

  actualValue Float             // Actual progress achieved
  remarks     String?           @db.Text // Optional comments or notes

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([targetId])
}

// ==========================================
// 5. Risk Monitoring & Analysis Model
// ==========================================
model Risk {
  id               String   @id @default(uuid())
  riskCategory     String   // Technical, Operational, Political, Environmental, Financial, Security
  riskDescription  String   @db.Text // Narrative (Max 300 words)
  probability      Float    // 0.1 to 1.0
  impact           Float    // 1 to 5
  riskIntensity    Float    // Calculated: Probability * Impact (P * I)
  riskAssessment   String   // High Risk (3.0-5.0), Medium Risk (2.0-2.9), Low Risk (1.0-2.8)
  responseStrategy String   // Mitigate, Accept, Avoid, Transfer, Share
  riskOwner        String   // e.g. Project coordinator
  status           String   @default("Open") // Open, In progress, closed
  timestamp        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ==========================================
// 6. Lessons Learned Documentation Model
// ==========================================
model LessonLearned {
  id                       String   @id @default(uuid())
  component                String   // Dropdown selection (e.g., Capacity Building, Agribusiness Investment, etc.)
  whatWentWrong            String   @db.Text
  rootCauseAnalysis        String   @db.Text
  impact                   String   @db.Text
  actionableRecommendation String   @db.Text
  actionOwner              String
  timestamp                DateTime @default(now()) // Explicit Timestamp field
  updatedAt                DateTime @updatedAt
}

// ==========================================
// 7. Blog & Knowledge Portal Models
// ==========================================
model BlogPost {
  id         String       @id @default(cuid())
  title      String
  slug       String       @unique
  excerpt    String       @db.Text
  content    String       @db.Text
  category   BlogCategory @default(FIELD_INSIGHTS)
  authorName String
  authorRole String?
  location   String?
  tag        String?      @default("Case Study")
  imageUrl   String?      // 👈 Featured image URL field
  likes      Int          @default(0)
  published  Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  comments   Comment[]
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    String
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([postId])
}

// =========================================================================
// 8. NEW ADDITION: Advisories & Alerts Feature
// =========================================================================

enum QueryStatus {
  PENDING
  AI_ANSWERED
  AGENT_ANSWERED
  RESOLVED
}

enum AlertSeverity {
  INFO        // Daily best practices, general guidance
  WARNING     // Pest alerts, disease outbreaks
  URGENT      // Extreme weather, urgent market/price spikes
}

model AdvisoryQuery {
  id          String      @id @default(cuid())
  question    String      @db.Text
  cropOrTopic String?     // e.g., "Cassava Rot", "Pesticide Application"
  location    String?     // e.g., "Kano", "Oyo"
  status      QueryStatus @default(PENDING)
  
  // Responses
  aiAnswer    String?     @db.Text
  agentAnswer String?     @db.Text
  answeredBy  String?     // Agent Name or "AgriBot AI"
  
  authorName  String      @default("Anonymous Farmer")
  authorEmail String?
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model AgriculturalAlert {
  id           String        @id @default(cuid())
  title        String
  content      String        @db.Text
  category     String        // e.g., "Best Practice", "Pest Control", "Soil Management"
  severity     AlertSeverity @default(INFO)
  imageUrl     String?
  authorName   String        @default("AgriTech Advisory")
  isVerified   Boolean       @default(true) // Admin/Expert verification badge
  
  likes        Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}


// ==========================================
// Policy & Success Stories Model (Table 1)
// ==========================================
model SuccessStory {
  id          String   @id @default(uuid())
  farmerId    String?
  fullName    String
  state       String
  clusterName String?
  userGroup   String?
  location    String?
  gps         String?  // e.g. "7.3986° N, 3.9058° E"
  imageUrl    String?   // <-- Add this line to match your database schema
  narration   String   @db.Text // Max 300 words
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==========================================
// Routine Productivity Data Model (Table 2)
// ==========================================
model RoutinePerformance {
  id          String   @id @default(uuid())
  state       String   // e.g. "Kano", "Oyo", "National (HQ)"
  quarter     String   // e.g. "Q1", "Q2", "Q3", "Q4"
  year        String   // e.g. "2026"
  kpi         String   // e.g. "Farmers Registered", "Area under cultivation (Ha)"
  baseline    Float    @default(0.0)
  target      Float    @default(0.0)
  achievement Float    @default(0.0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


// ==========================================
// Policy Briefs Model (Admin Editable)
// ==========================================
model PolicyBrief {
  id              String   @id @default(uuid())
  title           String
  domain          String
  focus           String   @db.Text
  recommendations String[] // Array of strings for bullet points
  fontFamily      String   @default("sans") // "sans", "serif", or "mono"
  fontSize        String   @default("text-base") // "text-sm", "text-base", or "text-lg"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}